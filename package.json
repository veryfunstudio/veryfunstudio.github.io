{
  "name": "veryfunstudio.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && tsx scripts/generate-seo.ts",
    "deploy": "pnpm run build && pnpm exec gh-pages -d build/client -b release",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "react-router preview",
    "baseline": "node scripts/capture-visual-baseline.mjs",
    "og": "tsx scripts/generate-og-images.ts",
    "typecheck": "react-router typegen && tsc -b",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "framer-motion": "^14.0.0",
    "isbot": "^5.2.2",
    "lucide": "^1.52.0",
    "lucide-react": "^1.52.0",
    "morphicons": "^1.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "gh-pages": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.2"
  }
}
