{
  "name": "veryfunstudio.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && tsx scripts/generate-seo.ts",
    "deploy": "pnpm run build && pnpm exec gh-pages -d build/client -b release",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "react-router preview",
    "baseline": "node scripts/capture-visual-baseline.mjs",
    "og": "tsx scripts/generate-og-images.ts",
    "typecheck": "react-router typegen && tsc -b",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:built": "playwright test"
  },
  "dependencies": {
    "@react-router/dev": "^8.5.3",
    "@react-router/node": "^8.5.3",
    "@tailwindcss/postcss": "^4.3.5",
    "framer-motion": "^14.14.0",
    "isbot": "^5.2.4",
    "lucide": "^1.81.0",
    "lucide-react": "^1.81.0",
    "morphicons": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "gh-pages": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  }
}
