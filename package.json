    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "react-router preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-router/dev": "^8.1.0",
    "@react-router/node": "^8.1.0",
