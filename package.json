{
  "name": "cookabc.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && bun run scripts/generate-seo.ts",
    "deploy": "bun run build && bunx gh-pages -d build/client -b main",
    "postinstall": "bun run scripts/patch-react-router-dev.ts",
