{
  "name": "veryfunstudio.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && tsx scripts/generate-seo.ts",
    "deploy": "pnpm run build && pnpm exec gh-pages -d build/client -b release",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "react-router preview",
    "baseline": "node scripts/capture-visual-baseline.mjs",
    "og": "tsx scripts/generate-og-images.ts",
    "typecheck": "react-router typegen && tsc -b",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@react-router/dev": "^8.5.0",
    "@react-router/node": "^8.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "framer-motion": "^14.6.0",
    "isbot": "^5.2.2",
    "lucide": "^1.61.0",
    "lucide-react": "^1.61.0",
    "morphicons": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "gh-pages": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  }
}
